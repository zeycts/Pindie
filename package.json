{
  "name": "pindie",
  "version": "0.2.0",
  "private": true,
  "description": "Personal AI agent for indie development, built on Pi.",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/pi-smoke.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^26.2.0",
    "typebox": "1.3.7",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.4"
  }
}
