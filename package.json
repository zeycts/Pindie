{
  "name": "pindie",
  "version": "0.3.0",
  "private": true,
  "description": "Personal AI agent for indie development, built on Pi.",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "pindie": "node --experimental-strip-types src/pindie.ts",
    "control:mcp": "node --experimental-strip-types src/control-mcp-process.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/pi-smoke.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "typebox": "1.3.7",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@amaster.ai/pi-browser-use": "0.1.15",
    "@earendil-works/pi-tui": "0.87.1",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@notionhq/client": "5.26.0",
    "discord.js": "14.27.0",
    "https-proxy-agent": "^9.1.0",
    "undici": "6.28.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
